# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Ahrefs API (used to fetch Domain Rating as the "DA" column). Optional —
# domain authority lookups are skipped and existing values kept if unset.
AHREFS_API_KEY=""

# Brevo (transactional email). Sends a notification when a watched domain
# becomes available. Optional — notifications are skipped if unset.
# BREVO_SENDER_EMAIL must be a sender/domain verified in your Brevo account.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_NOTIFY_EMAIL=""
